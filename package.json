{
  "name": "obsidian-mermaid-kit",
  "version": "1.1.1",
  "private": true,
  "description": "Mermaid Kit — pan, zoom, and fullscreen for Obsidian Mermaid diagrams",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit --skipLibCheck && node scripts/validate.mjs",
    "version": "node scripts/version-bump.mjs",
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "obsidian",
    "mermaid"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
